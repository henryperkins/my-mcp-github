/**
 * Development configuration for wrangler
 * This configuration is for local development without migrations
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "azure-search-mcp",
	"main": "src/index-dynamic.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AzureSearchMCPDynamic",
				"name": "MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"logpush": false,
	"dev": {
		"port": 8788
	}
}