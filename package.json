{
  "name": "azure-search-mcp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:tail": "wrangler deploy -c tail-worker/wrangler.jsonc",
    "deploy:legacy": "wrangler deploy src/index.ts",
    "dev": "wrangler dev",
    "dev:both": "wrangler dev -c wrangler.jsonc -c tail-worker/wrangler.jsonc",
    "dev:legacy": "wrangler dev src/index.ts",
    "start": "wrangler dev",
    "build:dynamic": "tsc -p tsconfig.json --noEmit",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test:tools": "tsx test-mcp-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/inspector": "^0.16.3",
    "@modelcontextprotocol/sdk": "1.17.3",
    "agents": "^0.0.113",
    "workers-mcp": "^0.0.13",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "dotenv": "^16.4.7",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "5.8.3",
    "wrangler": "^4.29.0"
  }
}
