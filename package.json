{
  "name": "azure-search-mcp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:tail": "wrangler deploy -c tail-worker/wrangler.jsonc",
    "deploy:legacy": "wrangler deploy src/index.ts",
    "dev": "wrangler dev",
    "dev:both": "wrangler dev -c wrangler.jsonc -c tail-worker/wrangler.jsonc",
    "dev:legacy": "wrangler dev src/index.ts",
    "start": "wrangler dev",
    "build:dynamic": "tsc -p tsconfig.json --noEmit",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test:tools": "tsx test-mcp-tools.ts",
    "test:mcp-local": "AZURE_SEARCH_MOCK=true tsx test-mcp-tools.ts",
    "test:validate-local": "AZURE_SEARCH_MOCK=true tsx test-tool-validation.ts",
    "dev:mock": "AZURE_SEARCH_MOCK=true wrangler dev"
  },
  "dependencies": {
    "@modelcontextprotocol/inspector": "^0.16.5",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "agents": "^0.0.113",
    "workers-mcp": "^0.0.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dotenv": "^16.6.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.32.0"
  }
}
